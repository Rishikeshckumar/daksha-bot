# Slack tokens -> /opt/dakshabot/dakshabot.env  (chmod 600, owner = the bot user). Never commit the real file.
SLACK_BOT_TOKEN=xoxb-your-bot-user-oauth-token      # OAuth & Permissions -> Bot User OAuth Token
SLACK_APP_TOKEN=xapp-your-app-level-token           # Basic Information -> App-Level Tokens (scope: connections:write)
